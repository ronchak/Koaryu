# Koaryu API Render config vars
# Copy these names into Render. Do not commit real secret values.

FRONTEND_URL=https://koaryu.app
ENVIRONMENT=production
API_V1_PREFIX=/api/v1
DEMO_RESET_ENABLED=false
DEMO_RESET_STUDIO_IDS=
BILLING_PLATFORM_FEE_BPS=50

SUPABASE_URL=https://mimguepumzsgmcaycdsh.supabase.co
SUPABASE_DEVELOPMENT_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_ALLOW_LEGACY_HS256=false

STRIPE_MODE=live
LIVE_BILLING_ENABLED=false
CORE_SELF_CHECKOUT_ENABLED=true
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_RESTRICTED_KEY=rk_live_your_restricted_key
STRIPE_PLATFORM_WEBHOOK_SECRET=whsec_your_platform_webhook_secret
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your_connect_platform_scope,whsec_your_connect_connected_scope
STRIPE_KOARYU_CORE_PRICE_ID=price_your_koaryu_core_subscription

ACCOUNT_DELETION_WORKER_SECRET=long-random-secret-for-the-deletion-cron
BILLING_TRANSITION_WORKER_SECRET=long-random-secret-for-billing-transition-worker
BILLING_TRANSITION_SCHEDULER_ENABLED=false
OPERATIONAL_ALERTS_ENABLED=false
OPERATIONAL_ALERT_WORKER_SECRET=long-random-secret-for-operational-alert-evaluation
OPERATIONAL_ALERT_PRIMARY_URL=https://alerts.example.invalid/koaryu/primary
OPERATIONAL_ALERT_PRIMARY_HOST=alerts.example.invalid
OPERATIONAL_ALERT_PRIMARY_URL_SHA256=placeholder-sha256-of-exact-primary-url
OPERATIONAL_ALERT_PRIMARY_BEARER_SECRET=long-random-secret-for-primary-alert-delivery
OPERATIONAL_ALERT_PRIMARY_ACK_SECRET=long-random-secret-for-primary-alert-acknowledgement
OPERATIONAL_ALERT_BACKUP_URL=https://alerts.example.invalid/koaryu/backup
OPERATIONAL_ALERT_BACKUP_HOST=alerts.example.invalid
OPERATIONAL_ALERT_BACKUP_URL_SHA256=placeholder-sha256-of-exact-backup-url
OPERATIONAL_ALERT_BACKUP_BEARER_SECRET=long-random-secret-for-backup-alert-delivery
OPERATIONAL_ALERT_BACKUP_ACK_SECRET=long-random-secret-for-backup-alert-acknowledgement
SUPPORT_TRIAGE_SECRET=long-random-secret-for-support-ticket-triage

# Hosted startup validates these values before serving traffic. Render supplies
# RENDER_GIT_COMMIT automatically for the public health metadata; do not set it
# manually or copy a secret into it. Matching live webhooks remain enabled while
# Core self-checkout permits only the three named Admin-scoped Core operations.
# All other outbound live Stripe mutations stay closed unless the separately
# approved global, exact-candidate, and studio-scoped rollout gates all pass.
# Service-role clients refuse ambient HTTP proxies and CA-bundle overrides.
# If Render exits with a configuration refusal, fix the named config vars in the
# Render dashboard and redeploy.

# Missed-class automations. Keep both switches false until release/setup checks pass.
# See docs/missed-class-automation.md. These are server-only values.
EMAIL_PROVIDER=disabled
EMAIL_SEND_ENABLED=false
EMAIL_FROM_ADDRESS=koaryu@outlook.com
EMAIL_FROM_NAME=Koaryu
EMAIL_REPLY_TO=koaryu@outlook.com
# Nonempty: allow only these actual recipients, never redirect student messages.
# The only approved test mailbox is koaryu@outlook.com. Explicitly empty means live.
EMAIL_ALLOWED_RECIPIENTS=koaryu@outlook.com
EMAIL_GRAPH_CLIENT_ID=your-dedicated-microsoft-mail-client-id
EMAIL_GRAPH_CLIENT_SECRET=your-dedicated-microsoft-mail-client-secret
EMAIL_GRAPH_TENANT=consumers
EMAIL_TOKEN_ENCRYPTION_KEY=your-generated-fernet-key
AUTOMATION_WORKER_ENABLED=false
# Dedicated >=32-character random secret; must match the frontend server-only value.
AUTOMATION_WORKER_SECRET=long-random-secret-for-missed-class-worker
# Public HTTPS backend /api/v1 base for unsubscribe links; required when sending.
AUTOMATION_PUBLIC_API_URL=https://koaryu.onrender.com/api/v1
