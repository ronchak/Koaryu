# Koaryu Backend Environment Variables
# Copy this to .env and fill in your values

SUPABASE_URL=https://your-project.supabase.co
# Required when development deliberately uses a hosted non-production project.
SUPABASE_DEVELOPMENT_PROJECT_REF=your-project
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_ALLOW_LEGACY_HS256=true
FRONTEND_URL=http://localhost:4000
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
# Set true only in controlled demo/staging contexts where demo reset should be callable.
DEMO_RESET_ENABLED=false
DEMO_RESET_STUDIO_IDS=

# Stripe test-mode billing
STRIPE_MODE=test
LIVE_BILLING_ENABLED=false
CORE_SELF_CHECKOUT_ENABLED=false
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_RESTRICTED_KEY=rk_test_your_restricted_key
STRIPE_PLATFORM_WEBHOOK_SECRET=whsec_your_platform_webhook_secret
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_your_connect_webhook_secret
STRIPE_KOARYU_CORE_PRICE_ID=price_your_koaryu_core_subscription
BILLING_PLATFORM_FEE_BPS=50

# Internal worker/support shared secrets
ACCOUNT_DELETION_WORKER_SECRET=long-random-secret-for-the-deletion-worker
BILLING_TRANSITION_WORKER_SECRET=long-random-secret-for-billing-transition-worker
OPERATIONAL_ALERTS_ENABLED=false
OPERATIONAL_ALERT_WORKER_SECRET=long-random-secret-for-operational-alert-evaluation
OPERATIONAL_ALERT_PRIMARY_URL=https://alerts.example.invalid/koaryu/primary
OPERATIONAL_ALERT_PRIMARY_HOST=alerts.example.invalid
OPERATIONAL_ALERT_PRIMARY_URL_SHA256=placeholder-sha256-of-exact-primary-url
OPERATIONAL_ALERT_PRIMARY_BEARER_SECRET=long-random-secret-for-primary-alert-delivery
OPERATIONAL_ALERT_PRIMARY_ACK_SECRET=long-random-secret-for-primary-alert-acknowledgement
OPERATIONAL_ALERT_BACKUP_URL=https://alerts.example.invalid/koaryu/backup
OPERATIONAL_ALERT_BACKUP_HOST=alerts.example.invalid
OPERATIONAL_ALERT_BACKUP_URL_SHA256=placeholder-sha256-of-exact-backup-url
OPERATIONAL_ALERT_BACKUP_BEARER_SECRET=long-random-secret-for-backup-alert-delivery
OPERATIONAL_ALERT_BACKUP_ACK_SECRET=long-random-secret-for-backup-alert-acknowledgement
SUPPORT_TRIAGE_SECRET=long-random-secret-for-support-ticket-triage

# In ENVIRONMENT=staging or production, app startup fails if required Supabase,
# Stripe, internal-operation, or public frontend values are incomplete or unsafe.
# Staging additionally requires Koaryu's pinned origins, test Stripe mode, and
# matching test keys. Outbound live Stripe mutations remain closed by default and
# require the separately approved, studio-scoped rollout gate.
# Render supplies RENDER_GIT_COMMIT automatically; do not set it from a secret.
