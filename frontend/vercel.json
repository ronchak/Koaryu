{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false,
      "staging": true,
      "codex/launch-readiness-candidate": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/account-deletions/process-due",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/operational-alerts/evaluate",
      "schedule": "0 9 * * *"
    }
  ]
}
