{
  "name": "koaryu",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "sh -c 'cd backend && venv/bin/python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8001'",
    "dev:up": "sh ./scripts/dev-up.sh",
    "dev:down": "sh ./scripts/dev-down.sh",
    "dev:health": "sh -c 'curl -fsS http://localhost:4000 >/dev/null && curl -fsS http://127.0.0.1:8001/docs >/dev/null && echo \"Koaryu is up on 4000/8001\"'",
    "check:env-examples": "node --test scripts/check-env-examples.test.mjs scripts/verify-staging-isolation.test.mjs && node scripts/check-env-examples.mjs",
    "check:release-workflow": "node --test scripts/check-release-candidate-workflow.test.mjs scripts/check-performance-regression.test.mjs scripts/check-supabase-contract-inventory.test.mjs scripts/merge-release-pr.test.mjs scripts/studio-comp-migration-rollout.test.mjs scripts/verify-deployed-release.test.mjs && node scripts/check-release-candidate-workflow.mjs",
    "verify:deployed-release": "node scripts/verify-deployed-release.mjs",
    "capture:dashboard-performance": "node frontend/scripts/capture-dashboard-performance.mjs",
    "check:performance-regression": "node scripts/check-performance-regression.mjs",
    "check:supabase-contracts-local": "bash scripts/verify-supabase-contracts-local.sh",
    "verify:staging-isolation": "node scripts/verify-staging-isolation.mjs",
    "audit:support-privacy": "python3 scripts/audit-support-privacy.py",
    "profile:request-bodies": "backend/venv/bin/python backend/scripts/profile_request_body_buffering.py && npm --prefix frontend run profile:request-bodies",
    "profile:request-bodies:quick": "backend/venv/bin/python backend/scripts/profile_request_body_buffering.py --quick && npm --prefix frontend run profile:request-bodies -- --quick",
    "generate:api-types": "backend/venv/bin/python scripts/generate-api-types.py",
    "check:api-types": "backend/venv/bin/python scripts/generate-api-types.py --check",
    "dev:stripe-connect-smoke": "backend/venv/bin/python scripts/verify-connect-webhook-smoke.py --target local"
  }
}
