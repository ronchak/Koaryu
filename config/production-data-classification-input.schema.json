{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koaryu.example/schemas/production-data-classification-input-v1.json",
  "title": "Koaryu secret-safe production data classification input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_version",
    "snapshot",
    "source_counts",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_version": {
      "const": "koaryu-production-data-classification/v1"
    },
    "snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "source_counts": {
      "$ref": "#/$defs/sourceCounts"
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "opaqueReference": {
      "type": "string",
      "pattern": "^(backup|project|keyver|retention|entity|evidence)_[0-9a-f]{64}$"
    },
    "recordType": {
      "enum": [
        "auth_user",
        "studio",
        "studio_subscription",
        "studio_payment_account",
        "stripe_event"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backup_set_ref",
        "source_project_ref",
        "captured_at",
        "application_sha",
        "repository_migration_head",
        "remote_migration_history_digest",
        "backup_data_ciphertext_digest",
        "artifact_encryption_key_ref",
        "retention_location_ref",
        "opaque_ref_scheme",
        "opaque_ref_key_version",
        "extractor_version",
        "creation_role"
      ],
      "properties": {
        "backup_set_ref": {
          "type": "string",
          "pattern": "^backup_[0-9a-f]{64}$"
        },
        "source_project_ref": {
          "type": "string",
          "pattern": "^project_[0-9a-f]{64}$"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "application_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "repository_migration_head": {
          "type": "string",
          "pattern": "^[0-9]{14}$"
        },
        "remote_migration_history_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "backup_data_ciphertext_digest": {
          "$ref": "#/$defs/sha256Digest"
        },
        "artifact_encryption_key_ref": {
          "type": "string",
          "pattern": "^keyver_[0-9a-f]{64}$"
        },
        "retention_location_ref": {
          "type": "string",
          "pattern": "^retention_[0-9a-f]{64}$"
        },
        "opaque_ref_scheme": {
          "const": "hmac-sha256-v1"
        },
        "opaque_ref_key_version": {
          "type": "string",
          "pattern": "^keyver_[0-9a-f]{64}$"
        },
        "extractor_version": {
          "const": "aggregate-extractor/v1"
        },
        "creation_role": {
          "const": "codex_release_orchestrator"
        }
      }
    },
    "sourceCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auth_user",
        "studio",
        "studio_subscription",
        "studio_payment_account",
        "stripe_event"
      ],
      "properties": {
        "auth_user": {
          "$ref": "#/$defs/count"
        },
        "studio": {
          "$ref": "#/$defs/count"
        },
        "studio_subscription": {
          "$ref": "#/$defs/count"
        },
        "studio_payment_account": {
          "$ref": "#/$defs/count"
        },
        "stripe_event": {
          "$ref": "#/$defs/count"
        }
      }
    },
    "count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opaque_ref",
        "record_type",
        "evidence"
      ],
      "properties": {
        "opaque_ref": {
          "type": "string",
          "pattern": "^entity_[0-9a-f]{64}$"
        },
        "record_type": {
          "$ref": "#/$defs/recordType"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "count",
        "source_ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "live_customer_relationship",
            "historical_customer_relationship",
            "registered_system_dependency",
            "registered_synthetic_marker",
            "owner_approved_setup_attestation",
            "application_relationship",
            "recent_activity"
          ]
        },
        "count": {
          "$ref": "#/$defs/count"
        },
        "source_ref": {
          "type": "string",
          "pattern": "^evidence_[0-9a-f]{64}$"
        }
      }
    }
  }
}
